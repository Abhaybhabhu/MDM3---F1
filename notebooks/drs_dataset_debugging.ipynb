    "import fastf1\n",
    "\n",
    "session = fastf1.get_session(2023, 'Bahrain', 'R')\n",
    "    \n",
    "# ✅ Explicitly load telemetry — this is the key fix\n",
    "session.load(telemetry=True)\n",
    "\n",
    "lap = session.laps.pick_drivers('VER')\n",
    "tel = lap.get_telemetry()\n",
    "print(tel['DRS'].value_counts())"
   ]
